# Copy to .env and fill in values

# Telethon forwarder account (StringSession)
FORWARDER_SESSION=your_string_session_here

# Telegram API credentials (from my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Librarian (Booklink) account numeric ID - where forwarded messages are sent
LIBRARIAN_ID=987654321

# Comma-separated list of chat IDs or usernames to watch.
# Leave empty to watch any chat the forwarder account can see.
WATCH_CHATS=@somegroup,-1001234567890

# Webhook to receive JSON payloads:
# Defaults to the in-repo consumer when running with docker-compose
WEBHOOK_URL=http://consumer:8080/notify

# Optional: shared secret used to sign outgoing webhook payloads (HMAC-SHA256)
WEBHOOK_SECRET=your_webhook_shared_secret

# Seconds to wait for librarian reply after forwarding (tune as needed)
REPLY_TIMEOUT_S=30

# Where to store processed DB (mounted volume recommended in Docker)
PROCESSED_DB_PATH=/data/processed.db

# Optional: Custom regex to extract the link if your Booklink reply is different
# LINK_REGEX=(https?://[^\s]+/b/[A-Za-z0-9_\-]+(?:\?[^\s]+)?)

# Consumer (S3) example configuration (optional)
# If you run the consumer, set these so it can upload streamed files to S3/MinIO
S3_BUCKET=my-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_REGION=us-east-1
MINIO_ENDPOINT= # optional: set to https://minio.example.com for MinIO

# Uploader integration: stream Booklink URLs directly to an uploader service.
# Example: https://your-uploader.example.com/share/file/
UPLOADER_URL=https://uploader.example.com/share/file/
UPLOADER_API_KEY=your-uploader-api-key
UPLOADER_SHARE_BASE=https://uploader.example.com/#/?code=
UPLOADER_EXPIRE_STYLE=day
UPLOADER_EXPIRE_VALUE=1
UPLOADER_FILE_FIELD=file
